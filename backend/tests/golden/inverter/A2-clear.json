{
  "scenario": "Remove the planner's charge, keep the user's period",
  "requests": [
    {
      "method": "POST",
      "path": "/op/v3/device/scheduler/get",
      "body": {
        "deviceSN": "TESTSN0001"
      }
    },
    {
      "method": "POST",
      "path": "/op/v3/device/scheduler/enable",
      "body": {
        "deviceSN": "TESTSN0001",
        "isDefault": false,
        "groups": [
          {
            "startHour": 16,
            "startMinute": 0,
            "endHour": 18,
            "endMinute": 59,
            "workMode": "Feedin",
            "extraParam": {
              "fdSoc": 10,
              "fdPwr": 0,
              "minSocOnGrid": 10
            }
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/op/v3/device/scheduler/get",
      "body": {
        "deviceSN": "TESTSN0001"
      }
    }
  ],
  "outcome": "ok",
  "message": "The planner's force charge periods were removed.",
  "inverter_after": {
    "enable": 1,
    "groups": [
      {
        "startHour": 16,
        "startMinute": 0,
        "endHour": 18,
        "endMinute": 59,
        "workMode": "Feedin",
        "extraParam": {
          "fdSoc": 10,
          "fdPwr": 0,
          "minSocOnGrid": 10
        }
      }
    ]
  }
}
