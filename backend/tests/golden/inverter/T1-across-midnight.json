{
  "scenario": "Charge 23:40–05:30, split at midnight",
  "requests": [
    {
      "method": "POST",
      "path": "/op/v1/device/scheduler/get",
      "body": {
        "deviceSN": "TESTSN0001"
      }
    },
    {
      "method": "POST",
      "path": "/op/v1/device/scheduler/enable",
      "body": {
        "deviceSN": "TESTSN0001",
        "groups": [
          {
            "enable": 1,
            "startHour": 0,
            "startMinute": 0,
            "endHour": 5,
            "endMinute": 29,
            "workMode": "ForceCharge",
            "fdSoc": 80,
            "fdPwr": 3600,
            "minSocOnGrid": 10
          },
          {
            "enable": 1,
            "startHour": 23,
            "startMinute": 40,
            "endHour": 23,
            "endMinute": 59,
            "workMode": "ForceCharge",
            "fdSoc": 80,
            "fdPwr": 3600,
            "minSocOnGrid": 10
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/op/v1/device/scheduler/set/flag",
      "body": {
        "deviceSN": "TESTSN0001",
        "enable": 1
      }
    },
    {
      "method": "POST",
      "path": "/op/v1/device/scheduler/get",
      "body": {
        "deviceSN": "TESTSN0001"
      }
    }
  ],
  "outcome": "ok",
  "message": "Force charge to 80% written for 23:40–00:00, 00:00–05:30 and read back as written.",
  "inverter_after": {
    "enable": 1,
    "groups": [
      {
        "enable": 1,
        "startHour": 0,
        "startMinute": 0,
        "endHour": 5,
        "endMinute": 29,
        "workMode": "ForceCharge",
        "fdSoc": 80,
        "fdPwr": 3600,
        "minSocOnGrid": 10
      },
      {
        "enable": 1,
        "startHour": 23,
        "startMinute": 40,
        "endHour": 23,
        "endMinute": 59,
        "workMode": "ForceCharge",
        "fdSoc": 80,
        "fdPwr": 3600,
        "minSocOnGrid": 10
      }
    ]
  }
}
