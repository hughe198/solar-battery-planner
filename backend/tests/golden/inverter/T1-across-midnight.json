{
  "scenario": "Charge 23:40–05:30, split at midnight",
  "requests": [
    {
      "method": "POST",
      "path": "/op/v3/device/scheduler/get",
      "body": {
        "deviceSN": "TESTSN0001"
      }
    },
    {
      "method": "POST",
      "path": "/op/v3/device/scheduler/enable",
      "body": {
        "deviceSN": "TESTSN0001",
        "isDefault": false,
        "groups": [
          {
            "startHour": 0,
            "startMinute": 0,
            "endHour": 5,
            "endMinute": 29,
            "workMode": "ForceCharge",
            "extraParam": {
              "fdSoc": 80,
              "fdPwr": 3600,
              "minSocOnGrid": 10
            }
          },
          {
            "startHour": 23,
            "startMinute": 40,
            "endHour": 23,
            "endMinute": 59,
            "workMode": "ForceCharge",
            "extraParam": {
              "fdSoc": 80,
              "fdPwr": 3600,
              "minSocOnGrid": 10
            }
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/op/v3/device/scheduler/get",
      "body": {
        "deviceSN": "TESTSN0001"
      }
    }
  ],
  "outcome": "ok",
  "message": "Force charge to 80% 23:40–00:00, 00:00–05:30 written and read back as written.",
  "inverter_after": {
    "enable": 1,
    "groups": [
      {
        "startHour": 0,
        "startMinute": 0,
        "endHour": 5,
        "endMinute": 29,
        "workMode": "ForceCharge",
        "extraParam": {
          "fdSoc": 80,
          "fdPwr": 3600,
          "minSocOnGrid": 10
        }
      },
      {
        "startHour": 23,
        "startMinute": 40,
        "endHour": 23,
        "endMinute": 59,
        "workMode": "ForceCharge",
        "extraParam": {
          "fdSoc": 80,
          "fdPwr": 3600,
          "minSocOnGrid": 10
        }
      }
    ]
  }
}
